   "source": [
    "import fractions\n",
    "\n",
    "p1 = fractions.Fraction(3, 4)\n",
    "p2 = fractions.Fraction(1, 2)\n",
    "penjumlah = p1 + p2\n",
    "print(\"Hasil penjumlahan dari\", p1, \"dan\", p2, \"adalah\", penjumlah)"
   ]
  }
